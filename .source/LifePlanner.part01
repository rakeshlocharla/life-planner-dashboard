  const catJS = { id: uid(), name: "JavaScript", color: PALETTE[2], isLearning: true, notes: "", roadmap: [
    { id: uid(), name: "Basics", status: "completed", pct: 100 },
    { id: uid(), name: "Functions", status: "completed", pct: 100 },
    { id: uid(), name: "Arrays", status: "completed", pct: 100 },
    { id: uid(), name: "DOM", status: "completed", pct: 100 },
    { id: uid(), name: "Async JavaScript", status: "in-progress", pct: 60 },
    { id: uid(), name: "APIs", status: "not-started", pct: 0 },
    { id: uid(), name: "Projects", status: "not-started", pct: 0 },
  ], resources: [{ id: uid(), title: "MDN", url: "https://developer.mozilla.org" }] };
  const catWeb = { id: uid(), name: "Web Development", color: PALETTE[3], isLearning: true, notes: "", roadmap: [
    { id: uid(), name: "Express.js routing", status: "in-progress", pct: 20 },
    { id: uid(), name: "Middleware", status: "not-started", pct: 0 },
    { id: uid(), name: "REST API design", status: "not-started", pct: 0 },
  ], resources: [] };
  const catPersonal = { id: uid(), name: "Personal", color: PALETTE[4], isLearning: false, notes: "", roadmap: [], resources: [] };

  const tasks = [
    { id: uid(), name: "n8n automation research", categoryId: catAI.id, description: "Look at 3 real automation templates for client work.", date: today, startTime: "09:00", endTime: "09:30", estimatedMinutes: 30, actualMinutes: 0, priority: "medium", status: "in-progress", pct: 40, notes: "", link: "https://docs.n8n.io" },
    { id: uid(), name: "Backtracking practice (C++)", categoryId: catDSA.id, description: "3 LeetCode-style backtracking problems.", date: today, startTime: "10:00", endTime: "11:00", estimatedMinutes: 60, actualMinutes: 0, priority: "high", status: "not-started", pct: 0, notes: "", link: "" },
    { id: uid(), name: "Async/await deep dive", categoryId: catJS.id, description: "Revisit promise chaining edge cases.", date: today, startTime: "11:30", endTime: "12:00", estimatedMinutes: 30, actualMinutes: 30, priority: "medium", status: "completed", pct: 100, notes: "Solid now — move to error handling next.", link: "" },
    { id: uid(), name: "DP intro (C++)", categoryId: catDSA.id, description: "Memoization vs tabulation basics.", date: tomorrow, startTime: "10:00", endTime: "11:00", estimatedMinutes: 60, actualMinutes: 0, priority: "high", status: "not-started", pct: 0, notes: "", link: "" },
    { id: uid(), name: "Express middleware practice", categoryId: catWeb.id, description: "Build custom logging + error-handling middleware.", date: tomorrow, startTime: "18:00", endTime: "18:30", estimatedMinutes: 30, actualMinutes: 0, priority: "medium", status: "not-started", pct: 0, notes: "", link: "" },
