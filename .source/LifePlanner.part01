    { id: uid(), name: "Get comfortable with async JavaScript", description: "Promises, async/await, fetch, error handling — all solid.", categoryId: catJS.id, deadline: addDaysStr(today, 25), pct: 60, status: "in-progress", relatedTaskIds: [tasks[2].id], notes: "Build a small project after finishing this section." },
