async function loadData() {
  try {
    const res = await window.storage.get(STORAGE_KEY, false);
    if (res && res.value) return JSON.parse(res.value);
    throw new Error("empty");
  } catch (e) {
    const seeded = seedData();
    try { await window.storage.set(STORAGE_KEY, JSON.stringify(seeded), false); } catch (e2) {}
    return seeded;
  }
}

function Ring({ pct, size = 64, stroke = 7, color = "#0EA5E9" }) {
  const r = (size - stroke) / 2;
  const c = 2 * Math.PI * r;
  const off = c - (Math.min(100, Math.max(0, pct)) / 100) * c;
  return (
    <svg width={size} height={size} className="-rotate-90">
      <circle cx={size / 2} cy={size / 2} r={r} fill="none" stroke="#E2E8F0" strokeWidth={stroke} />
      <circle cx={size / 2} cy={size / 2} r={r} fill="none" stroke={color} strokeWidth={stroke} strokeDasharray={c} strokeDashoffset={off} strokeLinecap="round" />
    </svg>
  );
}

function Bar_({ pct, color }) {
  return (
    <div className="w-full h-1.5 rounded-full bg-slate-100 overflow-hidden">
      <div className="h-full rounded-full" style={{ width: `${Math.min(100, Math.max(0, pct))}%`, backgroundColor: color }} />
    </div>
  );
}

function catOf(categories, id) { return categories.find(c => c.id === id) || { name: "Uncategorized", color: "#94A3B8" }; }
function taskHours(tasks, field) { return tasks.reduce((s, t) => s + (Number(t[field]) || 0), 0) / 60; }
function catAvgPct(cat) { return cat.roadmap.length ? Math.round(cat.roadmap.reduce((s, t) => s + (Number(t.pct) || 0), 0) / cat.roadmap.length) : null; }

function computeStreak(tasks) {
  const hasCompleted = (dStr) => tasks.some(t => t.date === dStr && t.status === "completed");
  let cursor = new Date();
  if (!hasCompleted(fmtDate(cursor))) cursor.setDate(cursor.getDate() - 1);
  let streak = 0;
  while (hasCompleted(fmtDate(cursor))) { streak++; cursor.setDate(cursor.getDate() - 1); }
  return streak;
}

export default function LifePlanner() {
  const [data, setData] = useState(null);
  const [page, setPage] = useState("dashboard");
  const [selectedDate, setSelectedDate] = useState(todayStr());
  const [viewMonth, setViewMonth] = useState(() => { const d = new Date(); return { y: d.getFullYear(), m: d.getMonth() }; });
  const [taskModal, setTaskModal] = useState(null);
  const [catModalOpen, setCatModalOpen] = useState(false);
  const [selectedLearningCat, setSelectedLearningCat] = useState(null);
  const [goalModal, setGoalModal] = useState(null);
  const saveTimer = useRef(null);

  useEffect(() => { (async () => { const d = await loadData(); setData(d); setSelectedLearningCat(prev => prev); })(); }, []);

  useEffect(() => {
    if (!data) return;
    clearTimeout(saveTimer.current);
    saveTimer.current = setTimeout(() => {
      window.storage.set(STORAGE_KEY, JSON.stringify(data), false).catch(() => {});
    }, 400);
  }, [data]);

  useEffect(() => {
    if (data && !selectedLearningCat) {
      const firstLearning = data.categories.find(c => c.isLearning);
      if (firstLearning) setSelectedLearningCat(firstLearning.id);
    }
  }, [data]);

  if (!data) {
    return <div className="min-h-screen flex items-center justify-center bg-slate-50 text-slate-400 font-sans text-sm">Loading your planner…</div>;
  }

  const { categories, tasks, goals } = data;

  function updateTask(id, patch) {
    setData(d => ({ ...d, tasks: d.tasks.map(t => t.id === id ? { ...t, ...patch } : t) }));
  }
  function addTask(task) { setData(d => ({ ...d, tasks: [...d.tasks, { ...task, id: uid() }] })); }
  function deleteTask(id) {
    if (!window.confirm("Delete this task? This can't be undone.")) return;
    setData(d => ({ ...d, tasks: d.tasks.filter(t => t.id !== id) }));
  }
  function duplicateTask(t) { addTask({ ...t, name: t.name + " (copy)", status: "not-started", pct: 0, actualMinutes: 0 }); }

  function addCategory(name, color, isLearning) {
    setData(d => ({ ...d, categories: [...d.categories, { id: uid(), name, color, isLearning, notes: "", roadmap: [], resources: [] }] }));
  }
  function updateCategory(id, patch) {
    setData(d => ({ ...d, categories: d.categories.map(c => c.id === id ? { ...c, ...patch } : c) }));
  }
  function deleteCategory(id) {
    if (!window.confirm("Delete this category? Tasks in it will become uncategorized.")) return;
    setData(d => ({ ...d, categories: d.categories.filter(c => c.id !== id) }));
    if (selectedLearningCat === id) setSelectedLearningCat(null);
  }

  function addRoadmapTopic(catId, name) {
    updateCategory(catId, { roadmap: [...catOf(categories, catId).roadmap, { id: uid(), name, status: "not-started", pct: 0 }] });
  }
  function updateRoadmapTopic(catId, topicId, patch) {
    const cat = catOf(categories, catId);
    updateCategory(catId, { roadmap: cat.roadmap.map(t => t.id === topicId ? { ...t, ...patch } : t) });
  }
  function deleteRoadmapTopic(catId, topicId) {
    const cat = catOf(categories, catId);
    updateCategory(catId, { roadmap: cat.roadmap.filter(t => t.id !== topicId) });
  }
  function addResource(catId, title, url) {
    const cat = catOf(categories, catId);
    updateCategory(catId, { resources: [...cat.resources, { id: uid(), title, url }] });
  }
  function deleteResource(catId, resId) {
    const cat = catOf(categories, catId);
    updateCategory(catId, { resources: cat.resources.filter(r => r.id !== resId) });
  }
