        <div className="flex items-center gap-2">
          <button onClick={() => shiftMonth(-1)} className="w-8 h-8 rounded-lg border border-slate-200 hover:bg-slate-100 text-slate-500">‹</button>
          <div className="text-[13.5px] font-medium w-36 text-center">{monthLabel(viewMonth.y, viewMonth.m)}</div>
          <button onClick={() => shiftMonth(1)} className="w-8 h-8 rounded-lg border border-slate-200 hover:bg-slate-100 text-slate-500">›</button>
        </div>
      </div>

      <div className="bg-white border border-slate-200 rounded-xl p-4">
        <div className="grid grid-cols-7 text-[11px] text-slate-400 font-medium mb-2 px-1">
          {["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].map(d => <div key={d} className="text-center">{d}</div>)}
        </div>
        <div className="grid grid-cols-7 gap-1.5">
          {weeks.flat().map((d, i) => {
            if (!d) return <div key={i} />;
            const dt = dayTasks(d);
            const done = dt.filter(t => t.status === "completed").length;
            const pct = dt.length ? Math.round((done / dt.length) * 100) : 0;
            const isSel = d === selectedDate;
            const isToday = d === todayStr();
            return (
              <button key={i} onClick={() => setSelectedDate(d)}
                className={`h-20 rounded-lg border p-2 text-left flex flex-col justify-between transition-colors ${isSel ? "border-slate-900 bg-slate-900 text-white" : isToday ? "border-slate-300 bg-slate-50" : "border-slate-100 hover:border-slate-300"}`}>
                <div className={`text-[12px] font-semibold ${isSel ? "text-white" : "text-slate-700"}`}>{parseDate(d).getDate()}</div>
                {dt.length > 0 && (
                  <div>
                    <div className={`text-[10px] ${isSel ? "text-slate-300" : "text-slate-400"}`}>{done}/{dt.length} done</div>
                    <div className={`w-full h-1 rounded-full mt-1 ${isSel ? "bg-slate-700" : "bg-slate-100"} overflow-hidden`}>
                      <div className="h-full bg-emerald-400 rounded-full" style={{ width: `${pct}%` }} />
                    </div>
                  </div>
                )}
              </button>
            );
          })}
        </div>
      </div>

      <div className="bg-white border border-slate-200 rounded-xl p-5">
        <div className="flex items-center justify-between mb-4">
          <h2 className="text-[14.5px] font-semibold">{niceDate(selectedDate)}</h2>
          <button onClick={() => setTaskModal({ mode: "add", defaultDate: selectedDate })}
            className="text-[12.5px] font-medium bg-slate-900 text-white px-3 py-1.5 rounded-lg hover:bg-slate-700">+ Add task</button>
        </div>
        {selTasks.length === 0 && <div className="text-[13px] text-slate-400 py-6 text-center">No tasks for this day yet.</div>}
        <div className="divide-y divide-slate-100">
          {selTasks.map(t => {
            const cat = catOf(categories, t.categoryId);
            return (
              <div key={t.id} className="py-3 flex items-center gap-3">
                <span className="w-2 h-2 rounded-full shrink-0" style={{ backgroundColor: cat.color }} />
                <div className="flex-1 min-w-0">
                  <div className="text-[13.5px] font-medium truncate">{t.name}</div>
                  <div className="text-[11px] text-slate-400">{cat.name} · {t.startTime || "--:--"}–{t.endTime || "--:--"} · est {t.estimatedMinutes}m</div>
                </div>
                <span className={`text-[10.5px] font-medium px-1.5 py-0.5 rounded ${PRIORITY_STYLE[t.priority]}`}>{t.priority}</span>
                <span className="flex items-center gap-1.5 text-[11px] text-slate-500">
                  <span className={`w-1.5 h-1.5 rounded-full ${STATUS_DOT[t.status]}`} />{STATUS_LABEL[t.status]}
                </span>
                <span className="text-[11px] text-slate-400 w-9 text-right">{t.pct}%</span>
                <button onClick={() => setTaskModal({ mode: "edit", task: t })} className="text-[11.5px] text-slate-400 hover:text-slate-800 px-1.5">Edit</button>
                <button onClick={() => duplicateTask(t)} className="text-[11.5px] text-slate-400 hover:text-slate-800 px-1.5">Dup</button>
                <button onClick={() => deleteTask(t.id)} className="text-[11.5px] text-slate-400 hover:text-rose-600 px-1.5">Del</button>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
}

function TaskModal({ modal, categories, onClose, onSave, onDelete }) {
  const isEdit = modal.mode === "edit";
  const [t, setT] = useState(isEdit ? { ...modal.task } : {
    id: uid(), name: "", categoryId: categories[0]?.id || "", description: "", date: modal.defaultDate || todayStr(),
    startTime: "", endTime: "", estimatedMinutes: 30, actualMinutes: 0, priority: "medium", status: "not-started", pct: 0, notes: "", link: "",
  });

  function set(field, val) { setT(prev => ({ ...prev, [field]: val })); }

  return (
    <Modal onClose={onClose} title={isEdit ? "Edit task" : "Add task"}>
      <div className="grid grid-cols-2 gap-3">
        <Field label="Task name" full><input className="in" value={t.name} onChange={e => set("name", e.target.value)} placeholder="e.g. Backtracking practice" /></Field>
        <Field label="Category"><select className="in" value={t.categoryId} onChange={e => set("categoryId", e.target.value)}>{categories.map(c => <option key={c.id} value={c.id}>{c.name}</option>)}</select></Field>
        <Field label="Priority"><select className="in" value={t.priority} onChange={e => set("priority", e.target.value)}>{PRIORITY_OPTS.map(p => <option key={p} value={p}>{p}</option>)}</select></Field>
        <Field label="Date"><input type="date" className="in" value={t.date} onChange={e => set("date", e.target.value)} /></Field>
        <Field label="Status"><select className="in" value={t.status} onChange={e => set("status", e.target.value)}>{STATUS_OPTS.map(s => <option key={s} value={s}>{STATUS_LABEL[s]}</option>)}</select></Field>
        <Field label="Start time"><input type="time" className="in" value={t.startTime} onChange={e => set("startTime", e.target.value)} /></Field>
        <Field label="End time"><input type="time" className="in" value={t.endTime} onChange={e => set("endTime", e.target.value)} /></Field>
        <Field label="Estimated (min)"><input type="number" min="0" className="in" value={t.estimatedMinutes} onChange={e => set("estimatedMinutes", Number(e.target.value) || 0)} /></Field>
        <Field label="Actual (min)"><input type="number" min="0" className="in" value={t.actualMinutes} onChange={e => set("actualMinutes", Number(e.target.value) || 0)} /></Field>
        <Field label="Completion %"><input type="number" min="0" max="100" className="in" value={t.pct} onChange={e => set("pct", Math.min(100, Math.max(0, Number(e.target.value) || 0)))} /></Field>
        <Field label="Resource link" full><input className="in" value={t.link} onChange={e => set("link", e.target.value)} placeholder="https://..." /></Field>
        <Field label="Description" full><textarea className="in h-16" value={t.description} onChange={e => set("description", e.target.value)} /></Field>
        <Field label="Notes" full><textarea className="in h-16" value={t.notes} onChange={e => set("notes", e.target.value)} /></Field>
      </div>
      <div className="flex items-center justify-between mt-5">
        <div>{isEdit && <button onClick={() => onDelete(t.id)} className="text-[12.5px] text-rose-600 font-medium hover:underline">Delete task</button>}</div>
        <div className="flex gap-2">
          <button onClick={onClose} className="text-[12.5px] font-medium px-3.5 py-2 rounded-lg border border-slate-200 hover:bg-slate-50">Cancel</button>
          <button onClick={() => onSave(t)} disabled={!t.name.trim()} className="text-[12.5px] font-medium px-3.5 py-2 rounded-lg bg-slate-900 text-white hover:bg-slate-700 disabled:opacity-40">Save task</button>
        </div>
      </div>
      <style>{`.in{width:100%;font-size:13px;border:1px solid #E2E8F0;border-radius:8px;padding:7px 9px;outline:none;background:#F8FAFC;} .in:focus{border-color:#94A3B8;background:white;}`}</style>
    </Modal>
  );
}

function Field({ label, children, full }) {
  return (
    <div className={full ? "col-span-2" : ""}>
      <div className="text-[11px] text-slate-400 font-medium mb-1">{label}</div>
      {children}
    </div>
  );
}

function Modal({ title, children, onClose }) {
  return (
    <div className="fixed inset-0 bg-slate-900/40 flex items-center justify-center z-50 p-4" onClick={onClose}>
      <div className="bg-white rounded-2xl p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto font-sans" onClick={e => e.stopPropagation()}>
        <h3 className="text-[15px] font-semibold mb-4">{title}</h3>
        {children}
      </div>
    </div>
  );
}

function CategoryModal({ categories, onClose, onAdd, onUpdate, onDelete }) {
  const [name, setName] = useState("");
  const [isLearning, setIsLearning] = useState(true);
  return (
    <Modal title="Manage categories" onClose={onClose}>
      <div className="space-y-2 mb-4">
        {categories.map(c => (
          <div key={c.id} className="flex items-center gap-2 py-1.5">
            <span className="w-2.5 h-2.5 rounded-full shrink-0" style={{ backgroundColor: c.color }} />
            <input className="in flex-1" value={c.name} onChange={e => onUpdate(c.id, { name: e.target.value })} />
            <label className="flex items-center gap-1 text-[11.5px] text-slate-500 shrink-0">
              <input type="checkbox" checked={c.isLearning} onChange={e => onUpdate(c.id, { isLearning: e.target.checked })} /> Learning
            </label>
            <button onClick={() => onDelete(c.id)} className="text-[11.5px] text-slate-400 hover:text-rose-600 px-1">Del</button>
          </div>
        ))}
      </div>
      <div className="flex items-center gap-2 border-t border-slate-100 pt-4">
        <input className="in flex-1" placeholder="New category name" value={name} onChange={e => setName(e.target.value)} />
        <label className="flex items-center gap-1 text-[11.5px] text-slate-500 shrink-0">
          <input type="checkbox" checked={isLearning} onChange={e => setIsLearning(e.target.checked)} /> Learning
        </label>
        <button onClick={() => { if (!name.trim()) return; onAdd(name.trim(), PALETTE[categories.length % PALETTE.length], isLearning); setName(""); }}
          className="text-[12.5px] font-medium px-3 py-2 rounded-lg bg-slate-900 text-white hover:bg-slate-700">Add</button>
      </div>
      <style>{`.in{font-size:13px;border:1px solid #E2E8F0;border-radius:8px;padding:6px 9px;outline:none;background:#F8FAFC;}`}</style>
    </Modal>
  );
}

function Learning({ categories, tasks, selectedLearningCat, setSelectedLearningCat, addRoadmapTopic, updateRoadmapTopic, deleteRoadmapTopic, addResource, deleteResource, updateCategory }) {
  const learningCats = categories.filter(c => c.isLearning);
  const cat = learningCats.find(c => c.id === selectedLearningCat) || learningCats[0];
  const [newTopic, setNewTopic] = useState("");
  const [resTitle, setResTitle] = useState(""); const [resUrl, setResUrl] = useState("");
  const [notesDraft, setNotesDraft] = useState(cat ? cat.notes : "");
  useEffect(() => { setNotesDraft(cat ? cat.notes : ""); }, [cat && cat.id]);

  if (!cat) return <div className="text-[13.5px] text-slate-400">No learning categories yet — add one from "Manage categories".</div>;

  const catTasks = tasks.filter(t => t.categoryId === cat.id);
  const totalH = taskHours(catTasks, "estimatedMinutes");
  const doneH = taskHours(catTasks, "actualMinutes");
  const pct = catAvgPct(cat);

  return (
    <div className="flex gap-6">
      <div className="w-48 shrink-0 space-y-1">
        {learningCats.map(c => (
          <button key={c.id} onClick={() => setSelectedLearningCat(c.id)}
            className={`w-full text-left px-3 py-2.5 rounded-lg text-[13px] font-medium flex items-center gap-2 ${c.id === cat.id ? "bg-slate-900 text-white" : "hover:bg-white border border-transparent hover:border-slate-200"}`}>
            <span className="w-2 h-2 rounded-full shrink-0" style={{ backgroundColor: c.color }} />
            <span className="truncate">{c.name}</span>
          </button>
        ))}
      </div>

      <div className="flex-1 space-y-6">
        <div className="flex items-center gap-4">
          <Ring pct={pct || 0} size={56} stroke={6} color={cat.color} />
          <div>
            <h1 className="text-xl font-semibold">{cat.name}</h1>
            <div className="text-[12.5px] text-slate-400">{pct === null ? "No topics yet" : `${pct}% overall`} · {doneH.toFixed(1)} / {totalH.toFixed(1)} hours logged</div>
          </div>
        </div>

        <div className="bg-white border border-slate-200 rounded-xl p-5">
          <h2 className="text-[14px] font-semibold mb-3">Roadmap</h2>
          <div className="space-y-1">
            {cat.roadmap.map(topic => (
              <div key={topic.id} className="flex items-center gap-3 py-2 border-b border-slate-100 last:border-0">
